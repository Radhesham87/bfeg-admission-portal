# ---- Admin sign-in (used by the admin panel) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pick-a-long-random-password

# ---- Session signing ----
# Generate one with:  python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-64-character-random-string
TOKEN_HOURS=8

# ---- Database ----
# Leave blank locally to use a SQLite file (bfeg_local.db).
# On Cloud Run this MUST point at a managed Postgres (Neon, Supabase, Cloud SQL),
# because the container filesystem is wiped on every restart.
DATABASE_URL=

# ---- CORS ----
# Your Netlify site, comma separated. Use * only while testing.
ALLOWED_ORIGINS=https://your-site.netlify.app

# ---- Optional ----
# The printed form asks for the student's CET portal password. Storing it means
# anyone with database access can log into their official CET account.
# Leave false unless your office has accepted that risk.
COLLECT_CET_PASSWORD=false
